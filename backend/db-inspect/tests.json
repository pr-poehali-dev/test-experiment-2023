{
  "tests": [
    {
      "name": "Без параметра — ошибка 400",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Запрос таблицы members",
      "method": "GET",
      "path": "/?table=members",
      "expectedStatus": 200,
      "expectedBody": {"table": "members"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Запрос несуществующей таблицы — 403",
      "method": "GET",
      "path": "/?table=secrets",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
